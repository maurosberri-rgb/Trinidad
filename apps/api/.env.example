# Puerto de la API
PORT=4500
# Clave inicial del usuario "admin" (solo se aplica al crear la base vacía). Si no se define, es "admin".
# ADMIN_PASSWORD=
# Con DATABASE_URL los datos y comprobantes se guardan en Supabase en vez de en apps/api/data.
# Usar la cadena del «Session pooler» de Supabase. Es un SECRETO: no se sube a GitHub.
# DATABASE_URL=postgresql://postgres.xxxx:CLAVE@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
# Detrás de un proxy (Cloudflare): 1
# TRUST_PROXY=1
# No cargar alumnos y familias de ejemplo al crear la base: 1
# SIN_DEMO=1

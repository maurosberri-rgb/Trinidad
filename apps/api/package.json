    "start": "node dist/index.js"
  },
  "dependencies": { "express": "^4.21.0" },
  "devDependencies": { "@types/express": "^4.17.21", "@types/node": "^22.5.4", "esbuild": "^0.24.0", "tsx": "^4.19.0", "typescript": "^5.5.4" }
}
